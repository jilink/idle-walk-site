# Tout est optionnel. Copie ce fichier en .env pour tester en local.
# Sur Cloudflare Pages / GitHub Pages, définis ces variables dans les réglages de build.

# URL finale du site (canonicals, sitemap, Open Graph). Sans slash final.
SITE_URL=https://idle-walk.cozy-codeur.fr

# Google Search Console : contenu de la balise <meta name="google-site-verification"> (méthode « balise HTML »).
PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 (ex. G-XXXXXXXXXX). Laisser vide = aucun script chargé.
PUBLIC_GA_ID=

# Plausible (respectueux de la vie privée, sans cookie). Ex. idle-walk.fr. Laisser vide = désactivé.
PUBLIC_PLAUSIBLE_DOMAIN=
