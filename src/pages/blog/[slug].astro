---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import FinalCta from '../../components/FinalCta.astro';
import { getPosts, CATEGORIES, fmtDate, readingMinutes } from '../../data/blog';
import { SITE_NAME } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id).slice(0, 3) } }));
}
const { post, others } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const path = `/blog/${post.id}/`;
const site = Astro.site!.toString().replace(/\/$/, '');
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: 'fr',
  mainEntityOfPage: site + path,
  image: site + '/og-idle-walk.png',
  author: { '@type': 'Organization', name: SITE_NAME, url: site + '/' },
  publisher: { '@type': 'Organization', name: SITE_NAME, url: site + '/' },
}];
---
<Base
  title={`${d.title} | Idle Walk`}
  description={d.description}
  path={path}
  jsonLd={jsonLd}
  crumbs={[{ name: 'Blog', path: '/blog/' }, { name: d.title, path }]}
>
  <article>
    <header class="ahead band-green">
      <div class="wrap">
        <nav class="crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/blog/">Blog</a> › <span>{CATEGORIES[d.category]}</span></nav>
        <h1>{d.title}</h1>
        <p class="meta">
          <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
          {d.updated && <> · mis à jour le <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></>}
          · {readingMinutes(post.body)} min de lecture
        </p>
      </div>
    </header>

    <div class="section">
      <div class="wrap prose body">
        <Content />
        <aside class="callout endcta">
          <p><strong>Envie de transformer tes pas en aventure ?</strong> Idle Walk est un jeu de marche gratuit pour Android : chaque pas devient des pièces pour débloquer des zones, des bonus et des compagnons.</p>
          <Cta place="blog-article" />
        </aside>
      </div>
    </div>
  </article>

  {others.length > 0 && (
    <section class="section band-mint wave-top">
      <div class="wrap">
        <h2 class="center">À lire aussi</h2>
        <div class="grid g3">
          {others.map((p) => (
            <a class="card rel" href={`/blog/${p.id}/`}><h3>{p.data.title}</h3><p>{p.data.description}</p></a>
          ))}
        </div>
      </div>
    </section>
  )}

  <FinalCta place="blog-final" />
</Base>
<style>
  .ahead { padding-block: 1.2rem clamp(40px, 6vw, 72px); }
  .crumbs { font-weight: 800; font-size: .9rem; margin-bottom: 1.2rem; }
  .crumbs a { color: var(--ink); }
  h1 { font-size: clamp(1.8rem, 5.5vw, 3rem); text-shadow: 0 3px 0 #ffffff80; max-width: 820px; }
  .meta { font-weight: 700; color: var(--ink); margin: 0; }
  .body { margin-inline: auto; }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(img) { max-width: 100%; height: auto; border-radius: 18px; }
  .body :global(blockquote) { border-left: 6px solid var(--green); margin-inline: 0; padding: .2rem 1.1rem; background: var(--card); border-radius: 0 14px 14px 0; }
  .body :global(table) { width: 100%; border-collapse: collapse; margin-block: 1.4rem; font-size: .96rem; }
  .body :global(th), .body :global(td) { border-bottom: 2px solid var(--line); padding: .6rem .7rem; text-align: left; }
  .body :global(th) { background: var(--mint); }
  .endcta { margin-top: 3rem; }
  .rel { text-decoration: none; color: var(--ink); display: block; transition: transform .12s; }
  .rel:hover { transform: translateY(-3px); color: var(--ink); }
  .rel h3 { color: var(--green-deep); font-size: 1.1rem; }
</style>
