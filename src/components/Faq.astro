---
import { FAQ_ITEMS } from '../data/faq';
interface Props { items?: typeof FAQ_ITEMS; open?: boolean }
const { items = FAQ_ITEMS, open = false } = Astro.props;
---
<div>
  {items.map((it, i) => (
    <details class="faq" open={open && i === 0}>
      <summary><h3 style="display:inline;font-size:inherit;margin:0">{it.q}</h3></summary>
      <div class="ans" set:html={it.a} />
    </details>
  ))}
</div>
